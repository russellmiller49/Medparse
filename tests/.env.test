# .env.test
API_TITLE=Medparse API (tests)
API_VERSION=0.1.0
ENABLE_PIPELINE=false
API_KEY=test                   # harmless test key
UMLS_API_KEY=                  # empty → don’t hit UMLS network
NCBI_API_KEY=
NCBI_EMAIL=test@example.com
QUICKUMLS_PATH=/tmp/quickumls  # or leave empty to skip
ALLOWED_ORIGINS=http://localhost:7860
MAX_UPLOAD_MB=5
GROBID_URL=http://localhost:8070
TESTING=true
REQUIRE_API_KEY=true
